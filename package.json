{
  "name": "mrktflow",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": "22.23.3",
    "npm": "10.9.9"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint resources/js themes/default/src tests/Browser vite.config.ts playwright.config.ts eslint.config.js --max-warnings=0",
    "format:check": "prettier --check resources/js resources/css themes/default/src themes/default/theme.json tests/Browser vite.config.ts playwright.config.ts eslint.config.js tsconfig.json package.json",
    "test:unit": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@inertiajs/vue3": "^3.9.1",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.5",
    "globals": "^16.0",
    "jsdom": "^27.0",
    "laravel-vite-plugin": "^3.1",
    "prettier": "^3.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0",
    "vite": "^8.0",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.1"
  }
}
