APP_NAME=MRKTFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=single
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mrktflow_dev
DB_USERNAME=mrktflow_dev
DB_PASSWORD=
DB_SOCKET=
SESSION_DRIVER=database
SESSION_ENCRYPT=true
# Only local loopback development uses HTTP. Production enforces secure cookies.
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
# Array transport discards email locally; real transport is a later explicit setup.
MAIL_MAILER=array
MAIL_FROM_ADDRESS=store@example.test
MAIL_FROM_NAME=MRKTFlow
VITE_APP_NAME=MRKTFlow
