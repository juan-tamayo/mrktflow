#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
mysql_bin=${MRKTFLOW_MYSQL_BIN:-/opt/homebrew/opt/mysql@8.4/bin}
case "${1:-}" in
  start)
    test -d "$root/.runtime/mysql/data/mysql" || { echo 'Provision the private database first; see docs/development.md.' >&2; exit 1; }
    exec "$mysql_bin/mysqld" --no-defaults \
      --datadir="$root/.runtime/mysql/data" --socket="$root/.runtime/mysql/server.sock" \
      --pid-file="$root/.runtime/mysql/server.pid" --log-error="$root/.runtime/mysql/server.log" \
      --skip-networking --mysqlx=OFF --partial-revokes=ON
    ;;
  stop)
    exec "$mysql_bin/mysqladmin" --defaults-extra-file="$root/.runtime/mysql/admin.cnf" shutdown
    ;;
  *) echo 'Usage: bin/local-db start|stop' >&2; exit 1 ;;
esac
